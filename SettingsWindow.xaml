<Window x:Class="InternetSpeedMeter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="310" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#30FF3333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic brushes for Done button hover states -->
        <SolidColorBrush x:Key="DoneButtonHoverBgBrush" Color="#60CDFF"/>
        <SolidColorBrush x:Key="DoneButtonHoverFgBrush" Color="#000000"/>

        <!-- Windows 11 Fluent Action Button Style with Hover and Disabled Triggers -->
        <Style x:Key="FluentActionButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter x:Name="BtnContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource DoneButtonHoverBgBrush}"/>
                                <Setter TargetName="BtnContent" Property="TextElement.Foreground" Value="{DynamicResource DoneButtonHoverFgBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Dialog Container (Windows 11 Fluent Card) -->
    <Border x:Name="DialogBorder"
            Background="#F7212121"
            BorderBrush="#38FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Windows 11 Speedometer/Gauge Icon (\uEC3F) and ChromeClose (\uE8BB) -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderIcon"
                               Text="&#xEC3F;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CC2FF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText"
                               Text="Internet Speed Meter"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Style="{StaticResource CloseBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click">
                    <TextBlock x:Name="CloseIcon"
                               Text="&#xE8BB;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#AAAAAA"/>
                </Button>
            </Grid>

            <!-- Content Area with Windows 11 Fluent Icons -->
            <StackPanel Grid.Row="1">
                <!-- Card 1: Session Data -->
                <Border x:Name="Card1" Style="{StaticResource FluentCard}" Background="#18FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LabelSession" Text="SESSION TRAFFIC" FontSize="9.5" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        
                        <!-- Download row with Win11 Download glyph \uE896 -->
                        <Grid Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DlIconText" Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#4CC2FF" Opacity="1.0" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelDl" Text="Downloaded:" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TotalDownText" Text="0.0 MB" FontSize="11" FontWeight="SemiBold" Foreground="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Upload row with Win11 Upload glyph \uE898 -->
                        <Grid Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UlIconText" Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#6CCB5F" Opacity="1.0" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelUl" Text="Uploaded:" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TotalUpText" Text="0.0 MB" FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Status & Alignment -->
                <Border x:Name="Card2" Style="{StaticResource FluentCard}" Background="#18FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LabelTaskbar" Text="TASKBAR ALIGNMENT" FontSize="9.5" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        
                        <!-- Alignment with Win11 Dock/Pin glyph \uE740 -->
                        <Grid Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelMode" Text="Position:" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="AlignmentText" Text="Auto (Center)" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Theme with Win11 Color/Theme glyph \uE771 -->
                        <Grid Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelTheme" Text="Theme:" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ThemeText" Text="Auto (System)" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Windows Startup -->
                <Border x:Name="Card3" Style="{StaticResource FluentCard}" Background="#18FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <CheckBox x:Name="StartupCheckBox"
                              Content="Start with Windows"
                              FontSize="11.5"
                              FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                              Foreground="#FFFFFF"
                              Cursor="Hand"
                              Click="StartupCheckBox_Click"/>
                </Border>
            </StackPanel>

            <!-- Bottom Actions -->
            <Button x:Name="DoneButton"
                    Grid.Row="2"
                    Style="{StaticResource FluentActionButton}"
                    Content="Done"
                    Click="DoneButton_Click"/>
        </Grid>
    </Border>
</Window>
